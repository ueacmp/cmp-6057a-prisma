{
  "name": "Next.js + PostgreSQL + Prisma",
  "onCreateCommand": "bash .devcontainer/configure-universal.sh",
  "updateContentCommand": "npm ci --prefer-offline --no-audit --no-fund",
  "waitFor": "postStartCommand",
  "postAttachCommand": {
    "Next.js": "npm run dev -- --hostname 0.0.0.0 --port 3000",
    "Prisma Studio": "npm run db:studio"
  },
  "forwardPorts": [
    3000,
    5555
  ],
  "portsAttributes": {
    "3000": {
      "label": "Next.js dev server",
      "onAutoForward": "notify"
    },
    "5555": {
      "label": "Prisma Studio",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "codespaces": {
      "disableAutomaticConfiguration": true
    }
  },
  "postStartCommand": "docker compose -f .devcontainer/compose.yaml up -d --wait"
}
